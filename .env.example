# === Database (Vercel "Prisma Postgres" storage) ===
# Khi tạo Storage > Prisma Postgres trên Vercel, 4 biến này được tự động thêm —
# chạy `vercel env pull` để lấy về, không cần tự gõ tay.
# - DATABASE_URL         : kết nối trực tiếp (dùng cho prisma.config.ts / db push / migrate)
# - DATABASE_URL_POOLED  : kết nối pooled (dùng cho runtime trong src/lib/db.ts)
# - POSTGRES_URL, PRISMA_DATABASE_URL : Vercel/Prisma tự thêm, không cần đụng tới.
DATABASE_URL="postgres://user:password@host/dbname?sslmode=require"
DATABASE_URL_POOLED="postgres://user:password@host/dbname?sslmode=require&pgbouncer=true"

# === Vercel Blob (lưu ảnh gallery & file nhạc) ===
# Tạo tại Vercel Dashboard > Storage > Blob > Create Store, rồi copy token.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxx"

# === Admin đăng nhập ===
ADMIN_USERNAME="admin"
# Tạo hash bằng: node -e "console.log(require('bcryptjs').hashSync('mat-khau-cua-ban', 10))"
ADMIN_PASSWORD_HASH="$2a$10$xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# === Session ===
# Chuỗi bí mật ngẫu nhiên tối thiểu 16 ký tự, dùng để ký JWT phiên đăng nhập admin.
# Tạo bằng: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-this-to-a-long-random-string"
